# SIM-TKD — contoh .env PRODUKSI untuk aplikasi Laravel (migrasi)
# =================================================================
# Salin ke <DEPLOYPATH>/.env (DI LUAR repo: jangan pernah di-commit),
# lalu: php artisan key:generate && php artisan config:cache
#
# Rahasia yang WAJIB diisi:
#   1. DB_*  -> kredensial database legacy yang SAMA (lihat config/credentials.php)
#   2. SIMTKD_CUTOVER_SECRET -> harus SAMA dengan sso_secret di config/cutover.php
#      (sisi legacy). Hasilkan dengan: php -r "echo bin2hex(random_bytes(24));"

APP_NAME="SIM-TKD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://next.simtkd.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simtkdco_sipd
DB_USERNAME=simtkdco_user
DB_PASSWORD=

# Sesi disimpan di database (tabel `sessions`). Diisi `.simtkd.com` agar
# sesi Laravel ikut terbaca dari subdomain lain saat migrasi bertahap.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.simtkd.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache & queue memakai database (tanpa Redis di shared hosting).
CACHE_STORE=database
QUEUE_CONNECTION=database

# SMTP OTP (samakan dengan config/mail.php legacy).
MAIL_MAILER=smtp
MAIL_HOST=mail.simtkd.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@simtkd.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@simtkd.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Domain yang boleh memakai sesi (Sanctum) ---
SANCTUM_STATEFUL_DOMAINS="simtkd.com,www.simtkd.com,next.simtkd.com,doc.simtkd.com,peta.simtkd.com"

# --- Migrasi bertahap (cutover) ---
# AKTIFKAN setelah verifikasi: php laravel/tools/cutover/verifikasi.php
SIMTKD_CUTOVER_AKTIF=false
SIMTKD_CUTOVER_SECRET=
SIMTKD_CUTOVER_TTL=90
SIMTKD_CUTOVER_SKEW=15
SIMTKD_CUTOVER_LOG=true

# Kolom tenant & OTP
SIMTKD_TENANT_COLUMN=skpd
SIMTKD_DEBUG_OTP=false
