# SIM-TKD - konfigurasi Apache (cPanel)
# 1) Paksa HTTPS (mendukung hosting di balik proxy, mis. Cloudflare/LoadBalancer)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2) Lindungi file sensitif dari akses langsung
<FilesMatch "^(setup\.php|\.git|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# 2b) File .env (rahasia) TIDAK BOLEH diakses lewat web, di mana pun.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# 3) Aplikasi Laravel (migrasi) tidak boleh diakses lewat domain utama.
#    Document root aplikasi baru HARUS diarahkan ke laravel/public pada
#    subdomain terpisah (mis. next.simtkd.com) — lihat
#    laravel/docs/CUTOVER-TANPA-DOWNTIME.md. Aturan ini mencegah kode sumber
#    (termasuk .env) terunduh bila folder laravel/ ikut ter-deploy ke sini.
<IfModule mod_rewrite.c>
    RewriteRule ^laravel/ - [F,L]
</IfModule>
